    "version": "0.2.0",
    "configurations": [

        {
            "name": "Launch Chrome",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}"
        },
       
        {
            "type": "node-terminal",
            "name": "Run Script: dev",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}\\wisper-web-client"
        }
    ], 
    "compounds": [
    {
      "name": "Start and Debug React App",
      "configurations": ["Run Script: dev", "Launch Chrome"]
    }
  ]
}